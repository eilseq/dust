name:               tidal-parse-ffi

license:            GPL-3
license-file:       LICENSE
Extra-source-files: README.md

version:            0.1.0
build-type:         Simple
cabal-version:      >=1.10

library
  exposed-modules:  Sound.Tidal.Parse.FFI
  default-language: Haskell2010

  ghc-options:      -Wall
  hs-source-dirs:   src

  Build-depends:
      base >=4.8 && <5
    , containers < 0.7
    , tidal >= 1.8 && <1.10
    , tidal-parse >= 0.0.1
    , aeson >= 2.2.3
    , bytestring >= 0.12.2
    , vector >= 0.13

test-suite tests
  type:             exitcode-stdio-1.0
  main-is:          Test.hs
  hs-source-dirs:   test
  ghc-options:      -Wall
  other-modules:    Sound.Tidal.TidalParseFFITest
  build-depends:
      base ==4.*
    , containers < 0.7
    , tidal-parse-ffi
    , tidal-parse
    , tidal
    , aeson >= 2.2.3
    , bytestring >= 0.12.2
    , HUnit
    , vector >= 0.13

source-repository head
  type:             git
  location:         https://github.com/tidalcycles/tidal-parse-ffi
